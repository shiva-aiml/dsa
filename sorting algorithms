AIM:
Implementation of standard comparison-based sorting algorithms: Bubble Sort,
Selection Sort, Insertion Sort, Quick Sort, and Merge Sort.

THEORY:
- Bubble Sort: An elementary sorting algorithm that repeatedly steps through the
  list, compares adjacent pairs, and swaps them if they are unordered.
  Time Complexity: O(n^2).

- Selection Sort: Divides the input into sorted and unsorted regions, repeatedly
  locating the minimum element from the unsorted section and placing it at the
  beginning.
  Time Complexity: O(n^2).

- Insertion Sort: Builds the final sorted sequence one item at a time by removing
  an element and inserting it into its proper place among already sorted elements.
  Time Complexity: Average O(n^2).

- Quick Sort: A divide-and-conquer approach that partitions an array around a
  chosen pivot element such that smaller values lie to the left and greater values
  to the right, followed by recursive sub-array sorting.
  Time Complexity: Average O(n log n).

- Merge Sort: A divide-and-conquer algorithm that recursively splits an array
  into halves until single elements remain, then repeatedly merges the sorted
  halves back together.
  Time Complexity: O(n log n).
================================================================================
*/

#include <stdio.h>

// Utility function to print array elements
void print(int a[], int n) {
    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
}

// Bubble Sort Implementation
void bubble(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                int t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
        }
    }
}

// Selection Sort Implementation
void selection(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int m = i;
        for (int j = i + 1; j < n; j++)
            if (a[j] < a[m])
                m = j;
        int t = a[i];
        a[i] = a[m];
        a[m] = t;
    }
}

// Insertion Sort Implementation
void insertion(int a[], int n) {
    for (int i = 1; i < n; i++) {
        int x = a[i], j = i - 1;
        while (j >= 0 && a[j] > x) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = x;
    }
}

// Quick Sort Implementation
void quick(int a[], int l, int r) {
    if (l >= r) return;
    int i = l, j = r, p = a[r], t;
    while (i < j) {
        while (a[i] < p) i++;
        while (a[j] >= p && j > i) j--;
        if (i < j) {
            t = a[i];
            a[i] = a[j];
            a[j] = t;
        }
    }
    t = a[i];
    a[i] = a[r];
    a[r] = t;
    quick(a, l, i - 1);
    quick(a, i + 1, r);
}

// Helper function to merge divided sub-arrays
void merge(int a[], int l, int m, int r) {
    int i = l, j = m + 1, k = 0, b[20];
    while (i <= m && j <= r)
        b[k++] = (a[i] < a[j]) ? a[i++] : a[j++];
    while (i <= m) b[k++] = a[i++];
    while (j <= r) b[k++] = a[j++];
    for (i = l, k = 0; i <= r; i++)
        a[i] = b[k++];
}

// Merge Sort Implementation
void mergeSort(int a[], int l, int r) {
    if (l < r) {
        int m = (l + r) / 2;
        mergeSort(a, l, m);
        mergeSort(a, m + 1, r);
        merge(a, l, m, r);
    }
}

int main() {
    int a[] = {5, 2, 8, 1, 6}, n = 5;

    printf("Original: ");
    print(a, n);

    bubble(a, n);
    printf("Bubble: ");
    print(a, n);

    selection(a, n);
    printf("Selection: ");
    print(a, n);

    insertion(a, n);
    printf("Insertion: ");
    print(a, n);

    quick(a, 0, n - 1);
    printf("Quick: ");
    print(a, n);

    mergeSort(a, 0, n - 1);
    printf("Merge: ");
    print(a, n);

    return 0;
}

