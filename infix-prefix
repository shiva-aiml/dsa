/*
====================================================================
AIM : Implement infix to prefix conversion using stack.

Theory : 
An expression consists of operands and operators. In infix notation, 
the operator is written between operands (e.g., A+B), while in prefix 
notation, the operator is written before operands (e.g., +AB).

A stack is used to convert an infix expression into a prefix expression. 
The infix expression is reversed, parentheses are interchanged, converted 
to postfix using a stack, and then reversed again to obtain the prefix 
expression. This method follows operator precedence and associativity.

Example:
- Infix: (A+B)*C
- Prefix: *+ABC
====================================================================
*/

#include <iostream>
#include <stack>
#include <algorithm>

using namespace std;

int precedence(char op)
{
    if (op == '^')
        return 3;
    else if (op == '*' || op == '/')
        return 2;
    else if (op == '+' || op == '-')
        return 1;
    else
        return -1;
}

bool isOperator(char c)
{
    return (c == '+' || c == '-' || c == '*' || c == '/' || c == '^');
}

string infixToPrefix(string infix)
{
    reverse(infix.begin(), infix.end());
    for (int i = 0; i < infix.length(); i++)
    {
        if (infix[i] == '(')
            infix[i] = ')';
        else if (infix[i] == ')')
            infix[i] = '(';
    }

    stack<char> st;
    string postfix = "";

    for (int i = 0; i < infix.length(); i++)
    {
        char c = infix[i];

        if (isalnum(c))
        {
            postfix += c;
        }
        else if (c == '(')
        {
            st.push(c);
        }
        else if (c == ')')
        {
            while (!st.empty() && st.top() != '(')
            {
                postfix += st.top();
                st.pop();
            }
            if (!st.empty())
            {
                st.pop();
            }
        }
        else
        {
            while (!st.empty() && precedence(st.top()) >= precedence(c))
            {
                postfix += st.top();
                st.pop();
            }
            st.push(c);
        }
    }

    while (!st.empty())
    {
        postfix += st.top();
        st.pop();
    }

    reverse(postfix.begin(), postfix.end());
    return postfix;
}

int main()
{
    string infix;
    cout << "Enter Infix Expression: ";
    cin >> infix;

    cout << "Prefix Expression: " << infixToPrefix(infix);
    return 0;
}

